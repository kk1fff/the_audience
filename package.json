{
  "name": "personal-social-media",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev:web": "corepack pnpm --filter @social/web dev",
    "dev:worker": "corepack pnpm --filter @social/worker dev",
    "build": "corepack pnpm --filter @social/web build",
    "test": "node --experimental-strip-types --test apps/web/lib/*.test.ts packages/core/src/*.test.ts packages/db/src/*.test.ts packages/llm/src/*.test.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
